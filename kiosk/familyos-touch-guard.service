[Unit]
Description=FamilyOS wall touchscreen fallback guard
After=systemd-udevd.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/familyos-touch-guard
ExecStart=/usr/local/lib/familyos/touch-guard
Restart=always
RestartSec=5
RuntimeDirectory=familyos-touch
RuntimeDirectoryMode=0755
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateNetwork=true
ReadWritePaths=/sys/bus/hid/drivers /run/familyos-touch

[Install]
WantedBy=multi-user.target
