GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Six digits. Leave unset to disable /admin. Restart the server after changing.
FAMILYOS_ADMIN_PIN=

# Agent access at /api/mcp. Generate with: openssl rand -hex 32
# Leave unset to disable. Restart after changing; never use NEXT_PUBLIC_.
FAMILYOS_MCP_TOKEN=
