{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/calendar/**",
              "components/core/**",
              "components/lists/**",
              "components/nav/**",
              "components/tasks/**",
              "ui_kits/wall-display/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Nunito Sans))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Nunito Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='AllDayBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tone|multi|style|key|ref|className|style|children)$/]",
        "message": "<AllDayBar> doesn't accept that prop. Declared props: label, tone, multi, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AllDayBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:teal|blush|lilac|sage|coral|sand)$/]",
        "message": "<AllDayBar> tone must be one of 'teal' | 'blush' | 'lilac' | 'sage' | 'coral' | 'sand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|time|temp|weatherIcon|actions|style|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: title, time, temp, weatherIcon, actions, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|tone|size|ring|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, tone, size, ring, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:teal|blush|lilac|sage|coral|sand)$/]",
        "message": "<Avatar> tone must be one of 'teal' | 'blush' | 'lilac' | 'sage' | 'coral' | 'sand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarStack'] > JSXAttribute > JSXIdentifier[name!=/^(?:people|max|size|style|key|ref|className|style|children)$/]",
        "message": "<AvatarStack> doesn't accept that prop. Declared props: people, max, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:coral|amber|teal|lilac|neutral|quiet)$/]",
        "message": "<Badge> tone must be one of 'coral' | 'amber' | 'teal' | 'lilac' | 'neutral' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|disabled|onClick|style|key|ref|className|style|children)$/]",
